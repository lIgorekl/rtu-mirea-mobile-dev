<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar: ActionBar'ом будет MaterialToolbar из app_bar_main -->
    <style name="Base.Theme.NavigationDrawerApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/coffee_brown</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/coffee_caramel</item>
        <!-- подсветка выбранного пункта в шторке -->
        <item name="colorSecondaryContainer">@color/coffee_cream</item>
        <item name="colorOnSecondaryContainer">@color/coffee_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.NavigationDrawerApp" parent="Base.Theme.NavigationDrawerApp" />
</resources>
