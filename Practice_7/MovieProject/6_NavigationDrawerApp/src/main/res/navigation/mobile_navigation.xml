<?xml version="1.0" encoding="utf-8"?>
<!-- граф кофейни: стартовый раздел — "Меню" -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/nav_menu">

    <fragment
        android:id="@+id/nav_menu"
        android:name="com.mirea.korovkin.navigationdrawerapp.MenuFragment"
        android:label="@string/title_menu"
        tools:layout="@layout/fragment_menu" />

    <fragment
        android:id="@+id/nav_promo"
        android:name="com.mirea.korovkin.navigationdrawerapp.PromoFragment"
        android:label="@string/title_promo"
        tools:layout="@layout/fragment_promo" />

    <fragment
        android:id="@+id/nav_contacts"
        android:name="com.mirea.korovkin.navigationdrawerapp.ContactsFragment"
        android:label="@string/title_contacts"
        tools:layout="@layout/fragment_contacts" />
</navigation>
