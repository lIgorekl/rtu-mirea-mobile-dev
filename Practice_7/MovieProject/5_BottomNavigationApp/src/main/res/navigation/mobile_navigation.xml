<?xml version="1.0" encoding="utf-8"?>
<!-- граф: три пункта назначения, стартовый — "Сегодня".
     action'ов нет — между вкладками переключает NavigationUI по id из меню -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_today">

    <fragment
        android:id="@+id/navigation_today"
        android:name="com.mirea.korovkin.bottomnavigationapp.TodayFragment"
        android:label="@string/title_today"
        tools:layout="@layout/fragment_today" />

    <fragment
        android:id="@+id/navigation_workouts"
        android:name="com.mirea.korovkin.bottomnavigationapp.WorkoutsFragment"
        android:label="@string/title_workouts"
        tools:layout="@layout/fragment_workouts" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.mirea.korovkin.bottomnavigationapp.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" />
</navigation>
