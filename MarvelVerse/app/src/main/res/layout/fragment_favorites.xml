<?xml version="1.0" encoding="utf-8"?>
<!-- практика 7: вкладка "Избранное". три состояния: гость / пусто / список -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.FavoritesFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/favoritesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingVertical="6dp"
        android:visibility="gone"
        tools:listitem="@layout/item_movie"
        tools:visibility="visible" />

    <!-- вошёл, но ничего не добавил -->
    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="В избранном пока пусто.\nОткройте фильм и нажмите «☆ В избранное»."
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- гость: избранное только для вошедших (требование 6 из ТЗ) -->
    <LinearLayout
        android:id="@+id/guestBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="Избранное"
            android:src="@drawable/ic_nav_favorites"
            android:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Избранное доступно только после входа в аккаунт"
            android:textSize="16sp" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Войти или зарегистрироваться" />
    </LinearLayout>
</FrameLayout>
