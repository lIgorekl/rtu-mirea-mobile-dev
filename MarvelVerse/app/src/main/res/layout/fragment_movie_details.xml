<?xml version="1.0" encoding="utf-8"?>
<!-- практика 6: детали фильма, фильм берётся из общей MainViewModel -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.MovieDetailsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- popBackStack руками, системный "назад" делает то же самое -->
        <Button
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Назад" />

        <ImageView
            android:id="@+id/detailsPoster"
            android:layout_width="200dp"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="#B71C1C"
            android:contentDescription="Постер фильма"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/detailsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Железный человек" />

        <TextView
            android:id="@+id/detailsRelease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            tools:text="Дата выхода: 2008-04-30" />

        <TextView
            android:id="@+id/detailsOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            tools:text="Миллиардер Тони Старк..." />
    </LinearLayout>
</ScrollView>
