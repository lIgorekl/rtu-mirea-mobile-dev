<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MarvelVerse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- практика 7: красный Marvel для тулбара и нижнего меню -->
        <item name="colorPrimary">@color/marvel_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- "пилюля" под активной вкладкой снизу -->
        <item name="colorSecondaryContainer">@color/marvel_red_light</item>
        <item name="colorOnSecondaryContainer">@color/marvel_red_dark</item>
    </style>

    <style name="Theme.MarvelVerse" parent="Base.Theme.MarvelVerse" />
</resources>